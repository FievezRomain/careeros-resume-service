# Placeholder values only
OIDC_ISSUER=http://localhost:8080/realms/careeros
OIDC_JWKS_URL=http://localhost:8080/realms/careeros/protocol/openid-connect/certs
OIDC_AUDIENCE=careeros-api
RESUME_DATABASE_URL=postgresql+psycopg://resume_owner:placeholder@localhost:5432/careeros_resume
LOG_LEVEL=INFO
